<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.znty.rrs.mapper.WindCodeSyncMapper">
    <!-- 按扩展参数指定的天数使用数据库时间过滤；同一 SEC_ID 只保留 CHANGE_DATE 最新的记录。 -->
    <select id="queryRecentWindCodeChangeList" resultType="com.znty.rrs.entity.schedule.WindCodeChangeDto">
        SELECT c.OBJECT_ID
              ,c.SEC_ID
              ,c.S_INFO_WINDCODE AS windCode
              ,c.S_INFO_OLDWINDCODE AS oldWindCode
              ,c.S_INFO_NEWWINDCODE AS newWindCode
              ,c.CHANGE_DATE
        FROM ais_inv_ods.wind_cbondchangewindcode c
        WHERE c.CHANGE_DATE >= DATE_FORMAT(TIMESTAMPADD(DAY, -#{scanDays}, NOW()), '%Y%m%d')
          AND c.S_INFO_OLDWINDCODE != c.S_INFO_NEWWINDCODE
          AND NOT EXISTS (
              SELECT 1
              FROM ais_inv_ods.wind_cbondchangewindcode newer
              WHERE newer.SEC_ID = c.SEC_ID
                AND newer.CHANGE_DATE > c.CHANGE_DATE
          )
        ORDER BY c.CHANGE_DATE
                ,c.SEC_ID
    </select>

    <!-- 不使用 LIMIT 1；SEC_ID 唯一性被破坏时由 MyBatis 显式报错。 -->
    <select id="querySecurityBySecIdForUpdate" resultType="com.znty.rrs.entity.bo.SecurityInfoBo">
        SELECT * FROM rrs_securityinfo WHERE sec_id = #{secId} FOR UPDATE
    </select>

    <!-- 旧码登记与人工转正的状态条件更新共用同一行锁。 -->
    <select id="queryOldCodeRegistrationList" resultType="com.znty.rrs.entity.bo.TempSecurityCodeBo">
        SELECT * FROM rrs_temp_security_code
        WHERE temp_security_code = #{oldCode} AND is_deleted = 0
        ORDER BY id FOR UPDATE
    </select>

    <!-- 历史转正登记只读，不重置其状态或原始临时代码。 -->
    <select id="queryConvertedRegistrationList" resultType="com.znty.rrs.entity.bo.TempSecurityCodeBo">
        SELECT * FROM rrs_temp_security_code
        WHERE security_code = #{oldCode} AND status = 'updated' AND is_deleted = 0
        ORDER BY id FOR UPDATE
    </select>

    <!-- 完成标记与主档、业务转换同一事务提交；不在 AIS 表增加处理字段。 -->
    <select id="queryCompletedWindCodeChangeCount" resultType="int">
        SELECT COUNT(1) FROM rrs_temp_security_code
        WHERE status = 'updated' AND oprt_source = 'job'
          AND LOCATE(#{eventKey}, memo) > 0
    </select>

