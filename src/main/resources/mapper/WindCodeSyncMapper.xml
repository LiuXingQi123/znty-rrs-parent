    <!-- 旧主档保留为失效临时代码，旧代码和新代码不再共用 SEC_ID。 -->
    <update id="editSecurityWindCodeToTemporary">
        UPDATE rrs_securityinfo
        SET security_status = 'D'
           ,security_source = 'temporary'
           ,sec_id = #{tempSecId}
           ,ts = #{updateTime}
        WHERE wind_code = #{change.oldWindCode}
          AND security_source = #{oldSource}
