<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.znty.rrs.mapper.ScheduledTaskMapper">

    <!-- 查询全部未删除的定时任务配置列表，按主键升序 -->
    <select id="queryTaskList" resultType="com.znty.rrs.entity.bo.SysScheduledTaskBo">
        SELECT id
               ,task_code
               ,task_name
               ,description
               ,cron_expression
               ,schedule_enabled
               ,param_json
               ,last_run_status
               ,last_run_message
               ,last_run_time
               ,last_affected_count
               ,last_duration_ms
               ,last_trigger_type
               ,is_deleted
               ,crte_time
               ,updt_time
        FROM sys_scheduled_task
        WHERE IFNULL(is_deleted, 0) = 0
        ORDER BY id ASC
    </select>

    <!-- 分页查询未删除的定时任务配置 -->
    <select id="queryTaskPage" resultType="com.znty.rrs.entity.bo.SysScheduledTaskBo">
        SELECT id
               ,task_code
               ,task_name
               ,description
               ,cron_expression
               ,schedule_enabled
               ,param_json
               ,last_run_status
               ,last_run_message
               ,last_run_time
               ,last_affected_count
               ,last_duration_ms
               ,last_trigger_type
               ,is_deleted
               ,crte_time
               ,updt_time
        FROM sys_scheduled_task
        <where>
            IFNULL(is_deleted, 0) = 0
            <if test="keyword != null and keyword != ''">
                AND (
                    task_name LIKE CONCAT('%', #{keyword}, '%')
                    OR task_code LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="scheduleEnabled != null">
                AND IFNULL(schedule_enabled, 0) =
                <choose>
                    <when test="scheduleEnabled">1</when>
                    <otherwise>0</otherwise>
                </choose>
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <!-- 按主键查询单条未删除的定时任务配置 -->
    <select id="queryTaskById" resultType="com.znty.rrs.entity.bo.SysScheduledTaskBo">
        SELECT id
               ,task_code
               ,task_name
               ,description
               ,cron_expression
               ,schedule_enabled
               ,param_json
               ,last_run_status
               ,last_run_message
               ,last_run_time
               ,last_affected_count
               ,last_duration_ms
               ,last_trigger_type
               ,is_deleted
               ,crte_time
               ,updt_time
        FROM sys_scheduled_task
        WHERE id = #{id}
          AND IFNULL(is_deleted, 0) = 0
        LIMIT 1
    </select>

    <!-- 按任务编码查询单条未删除的定时任务配置 -->
    <select id="queryTaskByCode" resultType="com.znty.rrs.entity.bo.SysScheduledTaskBo">
        SELECT id
               ,task_code
               ,task_name
               ,description
               ,cron_expression
               ,schedule_enabled
               ,param_json
               ,last_run_status
               ,last_run_message
               ,last_run_time
               ,last_affected_count
               ,last_duration_ms
               ,last_trigger_type
               ,is_deleted
               ,crte_time
               ,updt_time
        FROM sys_scheduled_task
        WHERE task_code = #{taskCode}
          AND IFNULL(is_deleted, 0) = 0
        LIMIT 1
    </select>

    <!-- 新增定时任务配置（编码、名称、说明、cron、启停、扩展参数） -->
    <insert id="addTask" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_scheduled_task (task_code
                                       ,task_name
                                       ,description
                                       ,cron_expression
                                       ,schedule_enabled
                                       ,param_json
                                       ,is_deleted
                                       ,crte_time
                                       ,updt_time)
        VALUES (#{taskCode}
               ,#{taskName}
               ,#{description}
               ,#{cronExpression}
               ,#{scheduleEnabled}
               ,#{paramJson}
               ,0
               ,NOW()
               ,NOW())
    </insert>

    <!-- 按任务编码更新配置（名称、说明、cron、启停、扩展参数） -->
    <update id="editTask">
        UPDATE sys_scheduled_task
        SET cron_expression = #{cronExpression}
           ,schedule_enabled = #{scheduleEnabled}
           ,param_json = #{paramJson}
           ,task_name = #{taskName}
           ,description = #{description}
           ,updt_time = NOW()
        WHERE task_code = #{taskCode}
          AND IFNULL(is_deleted, 0) = 0
    </update>

    <!-- 按任务编码逻辑删除配置，并关闭调度开关 -->
    <update id="deleteTaskSoft">
        UPDATE sys_scheduled_task
        SET is_deleted = 1
           ,schedule_enabled = 0
           ,updt_time = NOW()
        WHERE task_code = #{taskCode}
          AND IFNULL(is_deleted, 0) = 0
    </update>

    <!-- 更新主表最近一次执行摘要（状态、说明、时间、影响条数、耗时、触发方式） -->
    <update id="editTaskLastRun">
        UPDATE sys_scheduled_task
        SET last_run_status = #{lastRunStatus}
           ,last_run_message = #{lastRunMessage}
           ,last_run_time = #{lastRunTime}
           ,last_affected_count = #{lastAffectedCount}
           ,last_duration_ms = #{lastDurationMs}
           ,last_trigger_type = #{lastTriggerType}
           ,updt_time = NOW()
        WHERE task_code = #{taskCode}
          AND IFNULL(is_deleted, 0) = 0
    </update>

    <!-- 写入定时任务配置变更审计事件（快照 + 操作人 + 操作类型） -->
    <insert id="addTaskEvent">
        INSERT INTO sys_scheduled_task_evt (id
                                           ,task_code
                                           ,task_name
                                           ,description
                                           ,cron_expression
                                           ,schedule_enabled
                                           ,param_json
                                           ,last_run_status
                                           ,last_run_message
                                           ,last_run_time
                                           ,last_affected_count
                                           ,last_duration_ms
                                           ,last_trigger_type
                                           ,is_deleted
                                           ,crte_time
                                           ,updt_time
                                           ,opter_id
                                           ,opt_time
                                           ,oprt_type)
        VALUES (#{bo.id}
               ,#{bo.taskCode}
               ,#{bo.taskName}
               ,#{bo.description}
               ,#{bo.cronExpression}
               ,#{bo.scheduleEnabled}
               ,#{bo.paramJson}
               ,#{bo.lastRunStatus}
               ,#{bo.lastRunMessage}
               ,#{bo.lastRunTime}
               ,#{bo.lastAffectedCount}
               ,#{bo.lastDurationMs}
               ,#{bo.lastTriggerType}
               ,#{bo.isDeleted}
               ,#{bo.crteTime}
               ,NOW()
               ,#{opterId}
               ,NOW()
               ,#{oprtType})
    </insert>

    <!-- 新增一条定时任务执行历史记录 -->
    <insert id="addRunLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_scheduled_task_run_log (task_code
                                               ,task_name
                                               ,trigger_type
                                               ,run_status
                                               ,message
                                               ,detail_log
                                               ,affected_count
                                               ,duration_ms
                                               ,start_time
                                               ,end_time
                                               ,operator_id
                                               ,operator_name
                                               ,is_deleted
                                               ,crte_time
                                               ,updt_time)
        VALUES (#{taskCode}
               ,#{taskName}
               ,#{triggerType}
               ,#{runStatus}
               ,#{message}
               ,#{detailLog}
               ,#{affectedCount}
               ,#{durationMs}
               ,#{startTime}
               ,#{endTime}
               ,#{operatorId}
               ,#{operatorName}
               ,0
               ,NOW()
               ,NOW())
    </insert>

    <!-- 查询执行历史列表（可按任务编码筛选），由 PageHelper 做外层分页 -->
    <select id="queryRunLogList" resultType="com.znty.rrs.entity.bo.SysScheduledTaskRunLogBo">
        SELECT id
               ,task_code
               ,task_name
               ,trigger_type
               ,run_status
               ,message
               ,detail_log
               ,affected_count
               ,duration_ms
               ,start_time
               ,end_time
               ,operator_id
               ,operator_name
               ,is_deleted
               ,crte_time
               ,updt_time
        FROM sys_scheduled_task_run_log
        <where>
            IFNULL(is_deleted, 0) = 0
            <if test="taskCode != null and taskCode != ''">
                AND task_code = #{taskCode}
            </if>
        </where>
        ORDER BY start_time DESC
                 ,id DESC
    </select>

    <!-- 查询指定任务最近一次成功执行的开始时间，作为增量任务水位线 -->
    <select id="queryLastSuccessStartTime" resultType="java.util.Date">
        SELECT start_time
        FROM sys_scheduled_task_run_log
        WHERE task_code = #{taskCode}
          AND run_status = 'success'
          AND IFNULL(is_deleted, 0) = 0
        ORDER BY start_time DESC
                 ,id DESC
        LIMIT 1
    </select>

</mapper>
